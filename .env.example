# AR Aging Dashboard — configuration
#
# This tool is fully local, deterministic, no-LLM, no-database, no-network.
# There are NO API keys to set. All values below are optional and have
# sensible defaults; copy to .env only if you want to override a default.

# structlog level (DEBUG | INFO | WARNING | ERROR)
AGENT_LOG_LEVEL=INFO

# Maximum upload size, in megabytes
AGENT_MAX_UPLOAD_MB=25

# Maximum number of rows accepted from a sheet
AGENT_MAX_ROWS=200000

# rapidfuzz high-confidence header-match cutoff (0-100)
AGENT_HEADER_MATCH_THRESHOLD=85

# Number of riskiest accounts to surface (Phase 2)
AGENT_RISK_TOP_N=5

# Max invoice rows returned by POST /api/invoices in the unfiltered drill-down
# view (Phase 4). total_count / subtotal_amount are always reported over the
# full filtered set regardless of this cap.
AGENT_DRILLDOWN_MAX_ROWS=1000

# Local server port
PORT=8001

# ---------------------------------------------------------------------------
# Scheduled daily email report (frontend/scripts/daily-report.mjs)
# ---------------------------------------------------------------------------
# An OPTIONAL ops job that, once a day, picks the newest .xlsx from a watched
# folder, renders the dashboard to a PDF, and emails it. It starts its own
# short-lived backend on an ephemeral port — it does NOT touch your :8001 server.
# Until SMTP is configured (blank password) the job runs in DRY-RUN mode and just
# saves the PDF under frontend/scripts/output/ instead of sending.

# Folder the job watches for AR exports (newest *.xlsx wins; ~$ lock files ignored).
AGENT_REPORT_WATCH_DIR=D:\Cowork\AR Dashboard Data

# Recipient of the daily report.
AGENT_REPORT_TO=sabyasachi.thakur@parksonspackaging.com

# From address (defaults to AGENT_SMTP_USER when blank).
AGENT_REPORT_FROM=

# Office 365 / Outlook SMTP (STARTTLS on 587).
AGENT_SMTP_HOST=smtp.office365.com
AGENT_SMTP_PORT=587
AGENT_SMTP_USER=sabyasachi.thakur@parksonspackaging.com
# App password from IT. KEEP THIS BLANK in .env.example and NEVER commit a real value.
# While blank, the job stays in DRY-RUN mode (renders + saves the PDF, does not send).
AGENT_SMTP_PASSWORD=

# Ephemeral port the job's throwaway backend binds (must be free; not your :8001).
AGENT_REPORT_PORT=8971
