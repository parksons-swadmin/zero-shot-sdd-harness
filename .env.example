AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=anthropic

# Override model (uses provider default when blank):
# AGENT_LLM_MODEL=claude-sonnet-4-6   (Anthropic default)
# AGENT_LLM_MODEL=gemini-2.5-flash     (Gemini default — fast/cheap; override to a "pro" tier for higher quality)

# Cheap/fast router model used by the query-classification node (Phase 2+); falls back to AGENT_LLM_MODEL if unset
# AGENT_LLM_ROUTER_MODEL=gemini-2.5-flash

# Set exactly ONE provider key:
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

# Data-analyst agent limits (defaults shown; all optional)
# AGENT_MAX_UPLOAD_BYTES=104857600
# AGENT_MAX_ITERATIONS=4
# AGENT_MAX_PLAN_STEPS=5
# AGENT_MAX_TOTAL_STEPS=8

# Gemini cost-estimation price table (USD per 1K tokens; placeholders — verify against current Gemini pricing before Phase 3 cost UI ships)
# AGENT_GEMINI_INPUT_PRICE_PER_1K=0.000075
# AGENT_GEMINI_OUTPUT_PRICE_PER_1K=0.0003

PORT=8001
